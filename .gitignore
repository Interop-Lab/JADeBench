# The curated sample is intentionally versioned
!samples/diverse6/corpus/work/
!samples/diverse6/corpus/work/**
!samples/diverse6/corpus/subjects/
!samples/diverse6/corpus/subjects/**
!samples/diverse6/sandbox/sandboxes/
!samples/diverse6/sandbox/sandboxes/**

# Canonical released result evidence is intentionally versioned
!results/
!results/**
results/**/logs/
results/**/transcripts/
results/**/checkpoints/
results/**/_archive/

# Never publish internal workspaces from this release tree
paper/
archive/
experiments/
third_party/JsDeObsBench/
third_party/JSIMPLIFIER/
*.tar
*.tar.gz
*.tgz
*.zip

# Final safeguards: sample allow-rules must never re-include generated trees
**/node_modules/
**/__pycache__/
**/.adb-eval/
**/.adb-baseline/
