{
  "name": "ccapture.js",
  "version": "2.0.0",
  "description": "Capture canvas-based animations at a fixed framerate, with motion blur and modern encoders (WebCodecs).",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "types": "./src/index.d.ts",
  "unpkg": "build/ccapture.umd.min.js",
  "jsdelivr": "build/ccapture.umd.min.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./CCapture": {
      "types": "./src/CCapture.d.ts",
      "import": "./src/CCapture.js"
    },
    "./TimeWarp": {
      "types": "./src/TimeWarp.d.ts",
      "import": "./src/TimeWarp.js"
    },
    "./FrameWrap": {
      "types": "./src/FrameWrap.d.ts",
      "import": "./src/FrameWrap.js"
    },
    "./umd": "./build/ccapture.umd.min.js"
  },
  "files": [
    "src",
    "build"
  ],
  "devDependencies": {
    "esbuild": "0.24.0",
    "playwright-core": "1.48.0",
    "typescript": "5.6.3"
  },
  "keywords": [
    "capture",
    "canvas",
    "webgl",
    "webgpu",
    "webcodecs",
    "animation",
    "motion-blur",
    "video",
    "gif"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spite/ccapture.js.git"
  },
  "author": "Jaume Sanchez <the.spite@gmail.com> (https://www.clicktorelease.com)",
  "license": "MIT",
  "homepage": "https://github.com/spite/ccapture.js#readme",
  "private": true
}